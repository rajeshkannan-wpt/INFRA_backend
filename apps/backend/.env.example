# Server
PORT=4000

# Postgres (Supabase)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:6543/postgres

# Auth
JWT_SECRET=replace-with-64-hex-chars

# CORS
CORS_ORIGIN=http://localhost:3000

# Hash salts (DB-2.3); GLOBAL_SALT is preferred, CONTACT_HASH_SALT is the fallback
GLOBAL_SALT=replace-with-64-hex-chars
CONTACT_HASH_SALT=replace-with-64-hex-chars

# Runtime
NODE_ENV=development
DEBUG=0
BACKEND_URL=http://localhost:4000

# SMS (optional — falls back to console when unset)
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=